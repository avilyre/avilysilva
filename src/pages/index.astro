---
import { ArrowRight } from "lucide-astro";
import PageWrapper from "@src/components/layouts/wrapper.astro";
---

<PageWrapper>
  <main
    class="mt-20 h-[calc(100vh-265px)] max-h-[740px] lg:mt-14 lg:h-[calc(100vh-295px)]"
  >
    <header
      class="mx-auto flex max-w-[490px] flex-col items-center gap-12 lg:gap-14"
    >
      <div>
        <h1
          class="-leading-6 text-primary text-center text-6xl font-semibold lg:text-8xl"
        >
          avily silva
        </h1>
        <h2 class="text-primary text-right text-base font-light lg:text-2xl">
          frontend engineer
        </h2>
      </div>

      <p class="text-secondary text-center text-sm text-balance lg:text-xl">
        construindo e compartilhando experiências sobre a criação de interfaces
        modernas
      </p>

      <a href="/about" class="flex justify-center">
        <span class="relative flex">
          <span
            tabindex="0"
            class="absolute h-full w-full rounded-full bg-slate-600 opacity-75"
          ></span>
          <span
            class="border-surface relative flex items-center justify-center gap-2 rounded-full border-2 bg-slate-950 px-4 py-2 transition-colors hover:bg-slate-900/90"
          >
            sobre mim
            <ArrowRight class="h-4 w-4 text-white" />
          </span>
        </span>
      </a>
    </header>
  </main>
</PageWrapper>
