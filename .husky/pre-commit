pnpm run format
pnpm run lint
pnpm run build


branch="$(git rev-parse --abbrev-ref HEAD)"

RED=""
RESET=""
GREEN=""

if command -v tput >/dev/null 2>&1 && [ -t 1 ]; then
  RED=$(tput setaf 1)
  RESET=$(tput sgr0)
  GREEN=$(tput setaf 2)
fi

notAllowedBranchMessage="❌ ${RED}You can't commit to '$branch' branch!${RESET}"

successfullyMessage="${GREEN}You've successfully committed${RESET} 🚀!"

case "$branch" in
  production)
    echo "$notAllowedBranchMessage"
    exit 1
    ;;
  development)
    echo "$notAllowedBranchMessage"
    exit 1
    ;;
esac

echo "${GREEN}$successfullyMessage${RESET}"
